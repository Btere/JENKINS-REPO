pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Building the project...'
                sh '''
                    mkdir -p build
                    echo "Build complete" > build/output.txt
                '''
            }
        }

        stage('Test') {
            steps {
                echo 'Running tests...'
                sh 'echo "All tests passed"'
            }
        }

        stage('Package') {
            steps {
                echo 'Packaging artifacts...'
                sh '''
                    ls -la
                    tar -czf build.tar.gz build
                    ls -la
                '''
            }
        }
    }

    post {
        success {
            echo 'Archiving artifacts...'
            archiveArtifacts artifacts: 'build.tar.gz'
        }
        always {
            cleanWs()
        }
    }
}
