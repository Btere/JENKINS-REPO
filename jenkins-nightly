pipeline {
    agent any

    triggers {
        cron('H/5 * * * *')
    }

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        APP_NAME = "sample-app"
        BUILD_OUTPUT_DIR = "build"
        RESULT_FILE = "result.txt"
    }

    stages {

        stage('Initialize') {
            steps {
                echo "Initializing pipeline for ${APP_NAME}"
                sh """
                  mkdir -p ${BUILD_OUTPUT_DIR}
                """
            }
        }

        stage('Build') {
            steps {
                echo "Running build step..."
                sh """
                  echo "Build successful for ${APP_NAME}" > ${BUILD_OUTPUT_DIR}/${RESULT_FILE}
                """
            }
        }

        stage('Test (Safe)') {
            steps {
                echo "Running tests (safe mode)"
                sh """
                  echo "All tests passed" >> ${BUILD_OUTPUT_DIR}/${RESULT_FILE}
                """
            }
        }

        stage('Archive Artifacts') {
            steps {
                echo "Archiving build artifacts"
                archiveArtifacts artifacts: "${BUILD_OUTPUT_DIR}/**", fingerprint: true
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline completed successfully"
        }
        failure {
            echo "❌ Pipeline failed — check logs"
        }
        always {
            echo "📦 Build finished at: ${new Date()}"
        }
    }
}
