pipeline {
    agent any

    environment {
        AWS_DEFAULT_REGION = 'eu-west-1'
        S3_BUCKET = 'my-jenkins-bucket'
    }

    stages {
        stage('Create File') {
            steps {
                sh '''
                    mkdir -p build
                    echo "Hello from Jenkins" > build/output.txt
                '''
            }
        }

        stage('Upload to S3') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-jenkins'
                ]]) {
                    sh '''
                        aws s3 cp build/output.txt \
                        s3://$S3_BUCKET/builds/output-${BUILD_NUMBER}.txt
                    '''
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
